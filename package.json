{
  "name": "md-this-page",
  "displayName": ".MD this page",
  "version": "2.0.0",
  "description": "Turn any web page into clean, LLM-ready Markdown in one click",
  "author": "Adem Kouki <ademkingnew@gmail.com>",
  "scripts": {
    "build:extractor": "node scripts/build-extractor.mjs",
    "dev": "pnpm build:extractor && plasmo dev",
    "dev:verbose": "pnpm build:extractor && plasmo dev --verbose",
    "dev:firefox": "pnpm build:extractor && plasmo dev --target=firefox-mv3",
    "build": "pnpm build:extractor && plasmo build",
    "build:source": "pnpm build:extractor && plasmo build --source-maps",
    "build:chrome": "pnpm build:extractor && plasmo build --target=chrome-mv3 && node scripts/zip.mjs chrome-mv3-prod",
    "build:firefox": "pnpm build:extractor && plasmo build --target=firefox-mv3 --source-maps && node scripts/zip.mjs firefox-mv3-prod --with-maps",
    "build:edge": "pnpm build:extractor && plasmo build --target=edge-mv3 && node scripts/zip.mjs edge-mv3-prod",
    "build:safari": "pnpm build:extractor && plasmo build --target=safari-mv3",
    "build:all": "pnpm run build:chrome && pnpm run build:firefox && pnpm run build:edge",
    "package": "node scripts/zip.mjs",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.2",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "defuddle": "^0.19.4",
    "dompurify": "^3.4.16",
    "katex": "^0.16.45",
    "lucide-react": "^1.51.0",
    "marked": "^18.0.14",
    "marked-katex-extension": "^5.1.13",
    "plasmo": "0.90.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "postcss": "^8.5.10",
    "prettier": "3.2.4",
    "tailwindcss": "4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "activeTab",
      "scripting",
      "contextMenus",
      "storage",
      "clipboardWrite"
    ],
    "commands": {
      "convert-to-markdown": {
        "suggested_key": {
          "default": "Alt+M"
        },
        "description": "Convert current page to Markdown"
      }
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "ademking@md-this-page",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    }
  }
}
